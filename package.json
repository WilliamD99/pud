    "@payloadcms/storage-s3": "^3.69.0",
    "@payloadcms/ui": "3.69.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "15.4.10",
    "payload": "3.69.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
